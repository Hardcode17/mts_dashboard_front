    "keycloak-js": "26.2.5",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "serve-handler": "6.1.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
